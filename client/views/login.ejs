<!doctype html>
<html lang="en">
<head>
    <%- include('headernav') %>
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3>Вход</h3>
                    </div>
                    <div class="card-body">
                        <div id="errorMessagelog" class="alert alert-danger" style="display: none;"></div>
                        <form id="loginForm">
                            <div class="form-group">
                                <label for="loginUsername">Имя пользователя:</label>
                                <input type="text" class="form-control" id="loginUsername">
                            </div>
                            <div class="form-group">
                                <label for="loginPassword">Пароль:</label>
                                <input type="password" class="form-control" id="loginPassword">
                            </div>
                            <div class="form-group d-flex justify-content-between">
                                <a href="#" id="forgotPasswordLink">Забыли пароль?</a>
                                <a href="#" id="resendConfirmationLink">Переотправить письмо</a>
                            </div>
                            <button type="submit" class="btn btn-primary btn-block" id="loginButton1">Войти</button>
                        </form>

                        <form id="forgotPasswordForm" style="display: none;">
                            <div class="form-group">
                                <label for="forgotPasswordEmail">Email:</label>
                                <input type="email" class="form-control" id="forgotPasswordEmail">
                            </div>
                            <button type="submit" class="btn btn-primary btn-block" id="resetPasswordButton">Reset Password</button>
                        </form>

                        <form id="resendConfirmationForm" style="display: none;">
                            <div class="form-group">
                                <label for="resendEmail">Email:</label>
                                <input type="email" class="form-control" id="resendEmail">
                            </div>
                            <button type="submit" class="btn btn-primary btn-block" id="resendConfirmButton">Отправить письмо</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('footerbottom') %>
    
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/script.js" defer></script>
</body>
</html>
